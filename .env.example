# Copie vers .env et adapte les valeurs.

# Auth (obligatoire — chaîne longue aléatoire)
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Local (Docker Compose) ---
# docker compose up -d
DATABASE_URL="postgresql://student:student@localhost:5432/studentconnect?schema=public"

# --- Production (Vercel + Postgres managé UE) ---
# Neon, Prisma Postgres, Supabase, Railway… avec SSL :
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/studentconnect?sslmode=require"
