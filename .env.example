# Copie vers .env et adapte les valeurs.

# Auth (obligatoire — chaîne longue aléatoire)
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Local (Docker Compose) ---
# docker compose up -d
DATABASE_URL="postgresql://student:student@localhost:5432/studentconnect?schema=public"
DIRECT_URL="postgresql://student:student@localhost:5432/studentconnect?schema=public"

# --- Production (Neon + Vercel) ---
# DATABASE_URL = URL avec -pooler (app)
# DIRECT_URL   = même URL SANS -pooler (migrations Prisma)
# DATABASE_URL="postgresql://…@ep-….…-pooler.…aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://…@ep-….….aws.neon.tech/neondb?sslmode=require"

# URL publique de l’app (liens dans les e-mails)
APP_URL="http://localhost:3000"

# E-mails : log (défaut, journal SA) ou resend (envoi réel)
EMAIL_MODE="log"
# EMAIL_FROM="Student-Connect <noreply@ton-domaine.fr>"
# RESEND_API_KEY="re_…"
# Boîte qui reçoit les candidatures pilote (/nous-contacter)
# CONTACT_EMAIL="toi@exemple.fr"

# Cron Vercel / appel manuel : Authorization: Bearer …
# CRON_SECRET="change-me-cron-secret"

# Facturation publique (Checkout, /creer-residence, tarif Stripe sur landing).
# Absent ou autre que "true" = phase pilote gratuite (SA-only).
# BILLING_ENABLED="true"

# --- Stripe (conservé pour plus tard / tests ; inactif sans BILLING_ENABLED) ---
# Dashboard → Developers → API keys (sk_test_…)
# Products → créer UN prix récurrent → STRIPE_PRICE_ID (price_…)
# Webhook endpoint : https://TON_DOMAINE/api/stripe/webhook
# Events : checkout.session.completed, customer.subscription.*
# STRIPE_SECRET_KEY="sk_test_…"
# STRIPE_PRICE_ID="price_…"
# STRIPE_WEBHOOK_SECRET="whsec_…"
# Local : stripe listen --forward-to localhost:3000/api/stripe/webhook

# --- Vercel Blob (avatars + images d’annonces) ---
# Vercel → Storage → Blob → Create → copier le token
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_…"
# Sans token : fallback local public/uploads (OK en Docker, pas durable sur Vercel)
