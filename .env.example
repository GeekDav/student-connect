# Copie vers .env et adapte les valeurs.

# Auth (obligatoire — chaîne longue aléatoire)
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Local (Docker Compose) ---
# docker compose up -d
DATABASE_URL="postgresql://student:student@localhost:5432/studentconnect?schema=public"
DIRECT_URL="postgresql://student:student@localhost:5432/studentconnect?schema=public"

# --- Production (Neon + Vercel) ---
# DATABASE_URL = URL avec -pooler (app)
# DIRECT_URL   = même URL SANS -pooler (migrations Prisma)
# DATABASE_URL="postgresql://…@ep-….…-pooler.…aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://…@ep-….….aws.neon.tech/neondb?sslmode=require"

# URL publique de l’app (liens dans les e-mails)
APP_URL="http://localhost:3000"

# E-mails : log (défaut, journal SA) ou resend (envoi réel)
EMAIL_MODE="log"
# EMAIL_FROM="Student-Connect <noreply@ton-domaine.fr>"
# RESEND_API_KEY="re_…"

# Cron Vercel / appel manuel : Authorization: Bearer …
# CRON_SECRET="change-me-cron-secret"
