generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  MANAGER
  SUPER_ADMIN
}

enum ResidenceStatus {
  ACTIVE
  PAUSED
}

/** Pilote gratuit (SA) ou abonnement payant (self-serve Stripe). */
enum ResidencePlanType {
  PILOT
  PAID
}

enum MembershipStatus {
  PENDING
  ACTIVE
  LEFT
  REFUSED
}

enum SosStatus {
  OPEN
  HELPED
  CLOSED
  /** Fin de durée auto — distinct de CLOSED (résolu par l’auteur). */
  EXPIRED
}

enum MarketplaceType {
  DON
  VENTE
}

enum MarketplaceStatus {
  AVAILABLE
  RESERVED
  GONE
  /** Fin de durée auto — distinct de GONE (parti, marqué par l’auteur). */
  EXPIRED
}

enum ReportTargetType {
  EVENT
  SOS
  RECYCLERIE
  MESSAGE
  WALL
  WALL_REPLY
}

enum ReportStatus {
  OPEN
  REMOVED
  DISMISSED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           Role     @default(STUDENT)
  school         String?
  fieldOfStudy   String?
  interests      String?
  roomNumber     String?
  nationality    String?
  showNationality Boolean @default(false)
  bio            String?
  avatarUrl      String?
  /** Opt-in “dispo” jusqu’à cette date (ex. +7 jours). */
  availableUntil DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  managedResidence Residence?
  memberships      ResidenceMembership[]
  eventsCreated    MicroEvent[]          @relation("EventAuthor")
  eventJoins       EventParticipant[]
  sosCreated       SosRequest[]          @relation("SosAuthor")
  sosHelps         SosHelp[]
  marketItems      MarketplaceItem[]     @relation("MarketAuthor")
  marketInterests  MarketplaceInterest[]
  messagesSent     Message[]             @relation("MessageSender")
  conversationsA   Conversation[]        @relation("ConversationUserA")
  conversationsB   Conversation[]        @relation("ConversationUserB")
  reportsFiled     ModerationReport[]    @relation("ReportReporter")
  announcements    OfficialAnnouncement[]
  announcementReads AnnouncementRead[]
  wallNotes        WallNote[]            @relation("WallNoteAuthor")
  wallReplies      WallNoteReply[]       @relation("WallReplyAuthor")
  invitationsCreated ResidenceInvitation[] @relation("InvitationCreator")
}

model Residence {
  id        String            @id @default(cuid())
  name      String
  city      String
  address   String
  operator  String
  status    ResidenceStatus   @default(ACTIVE)
  planType  ResidencePlanType @default(PILOT)
  /** Rempli quand status = PAUSED. */
  pausedAt    DateTime?
  /** Conservation des données jusqu’à cette date (ex. +12 mois). */
  retainUntil DateTime?
  /** Dernier rappel hebdo envoyé (évite les doublons). */
  lastPauseReminderAt DateTime?
  /** Stripe (mode test puis live). */
  stripeCustomerId           String? @unique
  stripeSubscriptionId       String? @unique
  stripeSubscriptionStatus   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  managerId String? @unique
  manager   User?   @relation(fields: [managerId], references: [id])

  memberships   ResidenceMembership[]
  events        MicroEvent[]
  sosRequests   SosRequest[]
  marketItems   MarketplaceItem[]
  announcements OfficialAnnouncement[]
  reports       ModerationReport[]
  conversations Conversation[]
  wallNotes     WallNote[]
  invitations   ResidenceInvitation[]
}

/** Journal des e-mails (mode log test ou envois Resend). */
model EmailLog {
  id          String   @id @default(cuid())
  to          String
  subject     String
  template    String
  bodyPreview String
  status      String
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([template, createdAt])
}

model ResidenceMembership {
  id          String           @id @default(cuid())
  status      MembershipStatus @default(PENDING)
  leaveReason String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  decidedAt   DateTime?
  leftAt      DateTime?

  userId      String
  residenceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)

  @@unique([userId, residenceId])
  @@index([residenceId, status])
}

/** Lien / code d’invitation pour rejoindre une résidence (accès direct si valide). */
model ResidenceInvitation {
  id        String    @id @default(cuid())
  code      String    @unique
  label     String?
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  residenceId String
  createdById String
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("InvitationCreator", fields: [createdById], references: [id])

  @@index([residenceId, createdAt])
}

model OfficialAnnouncement {
  id          String   @id @default(cuid())
  title       String
  body        String
  imageUrl    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  unpublishedAt DateTime?

  residenceId String
  authorId    String
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id])
  reads       AnnouncementRead[]

  @@index([residenceId, published])
}

/** Lecture d’une annonce officielle par un étudiant. */
model AnnouncementRead {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  announcementId String
  userId         String
  announcement   OfficialAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId])
}

model MicroEvent {
  id          String   @id @default(cuid())
  title       String
  description String
  /** Début de l’événement (source de vérité). */
  startsAt    DateTime
  /** Fin — après quoi l’event disparaît automatiquement des listes. */
  endsAt      DateTime
  location    String
  spotsTotal  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  residenceId String
  authorId    String
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  author      User      @relation("EventAuthor", fields: [authorId], references: [id])
  participants EventParticipant[]

  @@index([residenceId])
  @@index([endsAt])
  @@index([residenceId, endsAt])
}

model EventParticipant {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  eventId   String
  userId    String
  event     MicroEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model SosRequest {
  id            String    @id @default(cuid())
  title         String
  description   String
  status        SosStatus @default(OPEN)
  /** Fin de visibilité « en cours » (TTL 7 j., +7 j. si prolongé 1×). */
  expiresAt     DateTime
  prolongedOnce Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  residenceId String
  authorId    String
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  author      User      @relation("SosAuthor", fields: [authorId], references: [id])
  helpers     SosHelp[]

  @@index([residenceId, status])
  @@index([expiresAt])
}

model SosHelp {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  sosId     String
  userId    String
  sos       SosRequest @relation(fields: [sosId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sosId, userId])
}

model MarketplaceItem {
  id            String            @id @default(cuid())
  title         String
  description   String
  type          MarketplaceType
  priceLabel    String?
  location      String
  status        MarketplaceStatus @default(AVAILABLE)
  /** Fin de visibilité active (TTL 30 j., +14 j. si prolongé 1×). */
  expiresAt     DateTime
  prolongedOnce Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  residenceId String
  authorId    String
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  author      User      @relation("MarketAuthor", fields: [authorId], references: [id])
  interests   MarketplaceInterest[]

  @@index([residenceId, status])
  @@index([expiresAt])
}

model MarketplaceInterest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  itemId    String
  userId    String
  item      MarketplaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userALastReadAt DateTime @default(now())
  userBLastReadAt DateTime @default(now())
  /** Masquée dans la liste pour userA (style WhatsApp — l’autre garde la sienne). */
  userAHiddenAt DateTime?
  userBHiddenAt DateTime?

  residenceId String
  userAId     String
  userBId     String
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  userA       User      @relation("ConversationUserA", fields: [userAId], references: [id])
  userB       User      @relation("ConversationUserB", fields: [userBId], references: [id])
  messages    Message[]

  @@unique([residenceId, userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Message {
  id             String   @id @default(cuid())
  body           String
  createdAt      DateTime @default(now())
  conversationId String
  senderId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

/** Petit mot du mur résidence (texte court, 1 / auteur / jour). */
model WallNote {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  residenceId String
  authorId    String
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  author      User      @relation("WallNoteAuthor", fields: [authorId], references: [id])
  replies     WallNoteReply[]

  @@index([residenceId, createdAt])
  @@index([authorId, createdAt])
}

/** Réponse publique sous une note du mur. */
model WallNoteReply {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  noteId   String
  authorId String
  note     WallNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author   User     @relation("WallReplyAuthor", fields: [authorId], references: [id])

  @@index([noteId, createdAt])
  @@index([authorId, createdAt])
}

model ModerationReport {
  id          String           @id @default(cuid())
  targetType  ReportTargetType
  targetId    String
  targetLabel String
  targetBody  String           @default("")
  reason      String
  status      ReportStatus     @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  residenceId String
  reporterId  String
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  reporter    User      @relation("ReportReporter", fields: [reporterId], references: [id])

  @@index([residenceId, status])
  @@index([targetType, targetId])
}
